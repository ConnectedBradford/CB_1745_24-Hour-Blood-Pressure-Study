#Full BMI from weight/height - 4277

#Full BMI from og data

SELECT
  person_id,
  weight,
  height,
  weight /POW(height / 100, 2) AS bmi

FROM 

(SELECT 
a.person_id,
a.height,
b.weight

FROM 

(#height
SELECT person_id, height

FROM 

(SELECT
  person_id,
  CAST (ROUND(height * 100) as INT64) AS height

FROM 
(SELECT person_id, height

FROM

(WITH WeightData AS (
  SELECT
    a.person_id,
    b.ctv3text,
    b.numericvalue,
    b.tbl_srcode_start_date,
    a.GCAPMR_date_of_diagnosis,
    ROW_NUMBER() OVER (PARTITION BY a.person_id ORDER BY ABS(DATE_DIFF(b.tbl_srcode_start_date, a.GCAPMR_date_of_diagnosis, DAY)) ASC) AS rn
  FROM
    yhcr-prd-phm-bia-core.CB_1745.Final_cohort_with_steroids a
  JOIN
    `yhcr-prd-phm-bia-core.CB_FDM_PrimaryCare.tbl_srcode` b
  ON
    a.person_id = b.person_id
  JOIN
    (SELECT
      code,
      ANY_VALUE(term) AS term
    FROM
      (SELECT 
        CAST(code AS STRING) AS code, 
        term
      FROM
        `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.height_codes`)
    GROUP BY
      code) c
  ON
    b.snomedcode = c.code
  WHERE
    b.tbl_srcode_start_date <= a.GCAPMR_date_of_diagnosis
)

SELECT
  person_id,
  ctv3text,
  CAST (numericvalue as FLOAT64) as height,
  tbl_srcode_start_date
FROM
  WeightData
WHERE
  rn = 1)

WHERE 
  height NOT IN (-1, 0, 0.3357) ) )

  WHERE height > 100) a,

