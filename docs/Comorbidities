#Smoking - if code from  clear available within last 5 years before PMR/GCA diagnosis, used that; if not then used code from smoking unclear; if that not available then 'missing'
--codelists: National diabetes audit (NDA) smoking habit codes / Smoking - Clear (SNOMED) / Smoking - Clear / Smoking habit codes / Codes indicating the patient has chosen not to give their smoking status 
-- unclear codelists: Smoking - Unclear / Support and refer stop smoking service and advisor codes / Smoking - Unclear (SNOMED) / Smoking Intervention and Advice





SELECT COUNT (person_id), smoking_status

FROM 
(WITH CTV3ToSnomed AS (
  -- First query - converts ctv3 codes to snomed codes
  SELECT
    CAST(a.SCT_CONCEPTID AS STRING) AS code,
    b.string_field_1 AS term
  FROM
    `yhcr-prd-phm-bia-core.CB_LOOKUPS.tbl_CTV3ToSnomed_Map_2` a
  JOIN
    `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.smoking_ctv3_codes` b
  ON
    b.string_field_0 = a.CTV3_CONCEPTID
  UNION ALL
  -- Second query - cast snomed code as string
  SELECT
    CAST(code AS STRING) AS code,
    term
  FROM
    `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.smoking_codes`
),

DeduplicatedSnomed AS (
  -- Deduplicate, only selecting one unique snomed code
  SELECT
    code,
    ANY_VALUE(term) AS term
  FROM
    CTV3ToSnomed
  GROUP BY
    code
),

JoinedData AS (
  SELECT
    a.person_id,
    b.ctv3text,
    b.tbl_srcode_start_date,
    a.GCAPMR_date_of_diagnosis,
    ROW_NUMBER() OVER (PARTITION BY a.person_id ORDER BY b.tbl_srcode_start_date DESC) AS rn
  FROM
    `yhcr-prd-phm-bia-core.CB_1745.Final_cohort_with_steroids` a
  JOIN
    `yhcr-prd-phm-bia-core.CB_FDM_PrimaryCare.tbl_srcode` b
  ON
    a.person_id = b.person_id
  JOIN
    DeduplicatedSnomed c
  ON
    b.snomedcode = c.code
  WHERE
    b.tbl_srcode_start_date <= a.GCAPMR_date_of_diagnosis
),

SmokingStatusUnclear AS (
  -- CTE for smoking status unclear
 SELECT
    CAST(a.SCT_CONCEPTID AS STRING) AS code,
    b.string_field_1 AS term
  FROM
    `yhcr-prd-phm-bia-core.CB_LOOKUPS.tbl_CTV3ToSnomed_Map_2` a
  JOIN
    `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.unclear_smoking_ctv3_codes` b
  ON
    b.string_field_0 = a.CTV3_CONCEPTID
  UNION ALL

  -- Second query - cast snomed code as string
  SELECT
    CAST(code AS STRING) AS code,
    term
  FROM
    `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.unclear_smoking_codes`
),

FinalSmokingStatus AS (
  SELECT
    a.person_id,
    CASE
      WHEN MAX(b.tbl_srcode_start_date) >= DATE_SUB(a.GCAPMR_date_of_diagnosis, INTERVAL 5 YEAR) THEN 
        MAX(b.ctv3text)
      WHEN EXISTS (
        SELECT 1
        FROM `yhcr-prd-phm-bia-core.CB_FDM_PrimaryCare.tbl_srcode` pc
        JOIN SmokingStatusUnclear ss
        ON pc.snomedcode = ss.code
        WHERE pc.person_id = a.person_id
        AND pc.tbl_srcode_start_date <= a.GCAPMR_date_of_diagnosis
      ) THEN 
        (SELECT MAX(ss.term)
         FROM `yhcr-prd-phm-bia-core.CB_FDM_PrimaryCare.tbl_srcode` pc
         JOIN SmokingStatusUnclear ss
         ON pc.snomedcode = ss.code
         WHERE pc.person_id = a.person_id
         AND pc.tbl_srcode_start_date <= a.GCAPMR_date_of_diagnosis
        )
      ELSE 'missing'
    END AS smoking_status
  FROM
    `yhcr-prd-phm-bia-core.CB_1745.Final_cohort_with_steroids` a
  LEFT JOIN
    JoinedData b
  ON
    a.person_id = b.person_id
  GROUP BY
    a.person_id, a.GCAPMR_date_of_diagnosis
)

-- Final query: Select distinct person_id and smoking status
SELECT
  person_id,
  smoking_status
FROM
  FinalSmokingStatus)

GROUP BY smoking_status

