WITH CTV3ToSnomed AS (
  -- First query - converts ctv3 codes to snomed codes
  SELECT
    CAST(a.SCT_CONCEPTID AS STRING) AS code,
    b.string_field_1 AS term
  FROM
    `yhcr-prd-phm-bia-core.CB_LOOKUPS.tbl_CTV3ToSnomed_Map_2` a
  JOIN
    `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.PAD_ctv3_codes` b
  ON
    b.string_field_0 = a.CTV3_CONCEPTID
  UNION ALL
  -- Second query - cast snomed code as string
  SELECT
    CAST(code AS STRING) AS code,
    term
  FROM
    `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.PAD_codes`
),

DeduplicatedSnomed AS (
  -- Fourth query - deduplicate, only selecting one unique snomed code
  SELECT
    code,
    ANY_VALUE(term) AS term
  FROM
    CTV3ToSnomed
  GROUP BY
    code
),

JoinedData AS (
  SELECT
    a.person_id,
    b.ctv3text,
    ROW_NUMBER() OVER (PARTITION BY a.person_id ORDER BY b.tbl_srcode_start_date DESC) AS rn
  FROM
    `yhcr-prd-phm-bia-core.CB_1745.Final_cohort_with_steroids` a
  JOIN
    `yhcr-prd-phm-bia-core.CB_FDM_PrimaryCare.tbl_srcode` b
  ON
    a.person_id = b.person_id
  JOIN
    DeduplicatedSnomed c
  ON
    b.snomedcode = c.code
  WHERE
    b.tbl_srcode_start_date <= a.GCAPMR_date_of_diagnosis
)

-- Final query: Select distinct person_id and the first ctv3text
SELECT
  person_id,
  ctv3text
FROM
  JoinedData
WHERE
  rn = 1;


