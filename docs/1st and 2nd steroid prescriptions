

#First steroid prescription
#Assign unique row number to each row for each patient, ordered ASC, with rows partitioned by patient_id
WITH prescription_ranked AS (
  SELECT
    person_id,
    diagnosis,
    prescription_date,
    ROW_NUMBER() OVER (PARTITION BY person_id ORDER BY prescription_date) AS prescription_rank,
    name_of_medication 

#Add two conditions - (1) prescription date needs to be after diagnosis date, (2) prescription date should be within 6 months of diagnosis date
  FROM
    yhcr-prd-phm-bia-core.CB_MYSPACE_KF.steroid_master_list_v3_datetime
  WHERE
    prescription_date >= date_of_diagnosis
    AND prescription_date <= DATE_ADD(date_of_diagnosis, INTERVAL 6 MONTH)
)

#Select rows where prescription_rank is 1, indicating first prescription fo reach patient
SELECT
  person_id,
  diagnosis,
  prescription_date AS first_steroid_prescription_date,
  name_of_medication
    
FROM prescription_ranked

WHERE 
prescription_rank = 1



-- SECOND STEROID PRESCRIPTION


#Define second_steroid_prescriptions from PMR_GCA_steorid_master table
WITH second_steroid_prescriptions AS (
    SELECT
        t1.person_id,
        t1.date_of_diagnosis,
        t1.prescription_date AS second_steroid_prescription_date,
        t1.name_of_medication as name_of_second_steroid,

#Assign a row number within each person_id partition ordered by prescription_date
        ROW_NUMBER() OVER (PARTITION BY t1.person_id ORDER BY prescription_date) AS prescription_rank
    
    FROM
         yhcr-prd-phm-bia-core.CB_MYSPACE_KF.steroid_master_list_v3_datetime t1

#Add conditions - second prescription date should be after first and within 6 months of first steroid prescription date
    WHERE
        prescription_date > (SELECT first_steroid_prescription_date FROM yhcr-prd-phm-bia-core.CB_MYSPACE_KF.1st_steroid_Rx_v1 t2 WHERE t2.person_id = t1.person_id)

        AND prescription_date <= DATE_ADD((SELECT first_steroid_prescription_date FROM yhcr-prd-phm-bia-core.CB_MYSPACE_KF.1st_steroid_Rx_v1 t2 WHERE t2.person_id = t1.person_id), INTERVAL 6 MONTH)
)

#Main query selecting variables from second_steroid_prescriptions and 1st_steroid_Rx
SELECT
    t2.person_id,
    t2.diagnosis,
    t3.date_of_diagnosis,
    t2.first_steroid_prescription_date,
    t2.name_of_medication as name_of_first_steroid,
    t3.second_steroid_prescription_date,
    t3.name_of_second_steroid

FROM
    yhcr-prd-phm-bia-core.CB_MYSPACE_KF.1st_steroid_Rx_v1 t2

#Subquery selecting second_steroid_prescriptions  
JOIN
    (
        SELECT
            person_id,
            second_steroid_prescription_date,
            date_of_diagnosis,
            name_of_second_steroid

        FROM
            second_steroid_prescriptions

#Select only the first-ranked second steroid prescription
        WHERE
            prescription_rank = 1
    ) t3
ON
    t2.person_id = t3.person_id;



