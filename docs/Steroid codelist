-- MAKING THE TABLES FORM THE CODELISTS ONLINE--

# (1) Other steroid table from: yhcr-prd-phm-bia-core.CB_MYSPACE_KF.other_steroid_codelist
# (2) Run with CB_BNF_DMD_SNOMED list
# (3) Save as yhcr-prd-phm-bia-core.CB_MYSPACE_KF.FINAL_other_steroid_list
SELECT 
a.prodcode as code, a.prodname as term, b.BNF_Code, b.BNF_Name, b.SNOMED_Code, b.DMplusD_ProductDescription,
b.DMplusD__Product_and_PackDescription, b.Pack
FROM 
`yhcr-prd-phm-bia-core.CB_MYSPACE_KF.other_steroid_codelist` a,
`yhcr-prd-phm-bia-core.CB_LOOKUPS.tbl_BNF_DMD_SNOMED_lkp` b

WHERE a.prodname = b.BNF_name

# (1) Steroid table from: yhcr-prd-phm-bia-core.CB_MYSPACE_KF.oral_steroid_codes_open_codelist
# (2) Run with CB_BNF_DMD_SNOMED list
# (3) Save as yhcr-prd-phm-bia-core.CB_MYSPACE_KF.FINAL_oral_steroid_list
SELECT
a.code, a.term,
b.BNF_Code, b.BNF_Name, b.SNOMED_Code, b.DMplusD_ProductDescription,
b.DMplusD__Product_and_PackDescription, b.Pack
FROM `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.oral_steroid_codes_open_codelist` a,
`yhcr-prd-phm-bia-core.CB_LOOKUPS.tbl_BNF_DMD_SNOMED_lkp` b
WHERE a.BNF_code = b.BNF_code

# (1) Prednisolone table from: yhcr-prd-phm-bia-core.CB_MYSPACE_KF.Oral_Pred_codes_open_codelist
# (2) Convert 'code' from integer to string, saved as additional column BNF_code in yhcr-prd-phm-bia-core.CB_MYSPACE_KF.cb_pred_codelist_converted
# (3) Run with CB_BNF_DMD_SNOMED list
# (4) Save as yhcr-prd-phm-bia-core.CB_MYSPACE_KF.FINAL_oral_pred_list
SELECT 
a.code, a.term,
b.BNF_Code, b.BNF_Name, b.SNOMED_Code, b.DMplusD_ProductDescription,
b.DMplusD__Product_and_PackDescription, b.Pack
FROM `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.cb_steroid_codelist_converted` a,
`yhcr-prd-phm-bia-core.CB_LOOKUPS.tbl_BNF_DMD_SNOMED_lkp` b
WHERE a.BNF_code = b.BNF_code

