#First 13 weeks

SELECT 
  --Median + mean
  PERCENTILE_CONT(total_dose_in_first_13w, 0.5) OVER() AS median
  #AVG(total_dose_in_first_13w)
FROM (
  SELECT 
    person_id,
    #Add up total_pred_doses from two UNION ALL tables (prescriptions that start+end within 13 weeks and prescriptions that start+do not end within 13 weeks)
    SUM(total_pred_dose) as total_dose_in_first_13w
  FROM (
    SELECT
      person_id,
      total_pred_dose
    FROM (
      #Total dose within first 13 weeks for prescriptions that start + end within the first 13 weeks
      SELECT
        person_id,
        diagnosis,
        GCAPMR_date_of_diagnosis,
        datemedicationstart,
        datemedicationend,
        duration_in_days,
        name_of_medication,
        number_of_tablets,
        daily_pred_dose,
        (daily_pred_dose * duration_in_days) AS total_pred_dose -- number of days x daily pred dose gives total pred dose
      FROM (
        SELECT 
          person_id,
          diagnosis,
          GCAPMR_date_of_diagnosis,
          datemedicationstart,
          DATE_ADD(datemedicationstart, INTERVAL duration_in_days DAY) AS datemedicationend,-- calculated like this as originally duration_in_days was calculated by difference in datemedicationstart between two prescriptions for some
          duration_in_days,
          name_of_medication,
          number_of_tablets,
          medicationquantity,
          medicationdosage,
          #Tablets per day multiplied by the equivalence dose to prednisolone 1mg gives daily dose
          (number_of_tablets / duration_in_days) * equivalence_dose_to_pred1mg AS daily_pred_dose
        FROM  yhcr-prd-phm-bia-core.CB_MYSPACE_KF.final_combined_steroid_conversions
        WHERE
          datemedicationstart >= GCAPMR_date_of_diagnosis -- select prescriptions starting on or after date of diagnosis
          AND datemedicationend <= DATE_ADD(GCAPMR_date_of_diagnosis, INTERVAL 13 WEEK) -- select prescriptions ending within the 13 week interval
      )
    )
    UNION ALL
    SELECT 
      person_id,
      total_pred_dose
    FROM (
      SELECT 
        person_id,
        diagnosis,
        GCAPMR_date_of_diagnosis,
        datemedicationstart,
        datemedicationend,
        duration_in_days,
        name_of_medication,
        number_of_tablets,
        medicationquantity,
        medicationdosage,
        daily_pred_dose,
        -- Calculate the dose received within the first 13 weeks by calculating the difference from datemedicationstart and day 91 from diagnosis_date
        DATE_DIFF(DATE_ADD(GCAPMR_date_of_diagnosis, INTERVAL 91 DAY), datemedicationstart, DAY) * daily_pred_dose AS total_pred_dose
      FROM (
        SELECT * 
        FROM (
          SELECT 
            person_id,
            diagnosis,
            GCAPMR_date_of_diagnosis,
            datemedicationstart,
            DATE_ADD(datemedicationstart, INTERVAL duration_in_days DAY) AS datemedicationend,
            duration_in_days,
            name_of_medication,
            number_of_tablets,
            medicationquantity,
            medicationdosage,
            (number_of_tablets / duration_in_days) * equivalence_dose_to_pred1mg AS daily_pred_dose
          FROM (
            SELECT *
            FROM yhcr-prd-phm-bia-core.CB_MYSPACE_KF.final_combined_steroid_conversions
            WHERE datemedicationstart >= GCAPMR_date_of_diagnosis -- Include only prescriptions that start on or after the diagnosis date
              AND datemedicationstart <= DATE_ADD(GCAPMR_date_of_diagnosis, INTERVAL 13 WEEK)
              AND datemedicationend > DATE_ADD(GCAPMR_date_of_diagnosis, INTERVAL 13 WEEK) -- Include only prescriptions that end after the 13-week mark from the diagnosis date
          )
        )
      )
    )
  )
  GROUP BY person_id
)


