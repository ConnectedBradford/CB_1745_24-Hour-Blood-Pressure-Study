#7 Raw steroid length 

#7a - raw steroid length with selected rules

***
WITH PrescriptionDurations AS (
    SELECT
        b.person_id,
        a.diagnosis,
        a.GCAPMR_date_of_diagnosis,
        b.datemedicationstart,
        b.datemedicationend,
        b.name_of_medication,
        b.medicationdosage,
        b.medicationquantity,

#LEAD function to get the start date of the next prescription for each person, partitioned by person_id and ordered by datemedicationstart
        LEAD(b.datemedicationstart) OVER (PARTITION BY b.person_id ORDER BY b.datemedicationstart) AS lead_datemedicationstart

#Joining the final cohort table with the steroid master list table
    FROM
        yhcr-prd-phm-bia-core.CB_1745.Final_cohort_with_steroids a
    JOIN
        yhcr-prd-phm-bia-core.CB_1745.steroid_master_list_FINAL_DEDUPED b
    ON
        a.person_id = b.person_id
    WHERE

#Filtering for medication start dates between 2000-01-01 and 2024-01-01 and after the date of diagnosis
        b.datemedicationstart >= '2000-01-01'
        AND b.datemedicationstart >= a.GCAPMR_date_of_diagnosis
)
SELECT
    person_id,
    diagnosis,
    GCAPMR_date_of_diagnosis,
    datemedicationstart,
    datemedicationend,

#CASE statement to calculate the duration_in_days based on given rules
    CASE

#If difference between start and end is 5 days or more then duration in days calculated as difference between datemedication start and datemedicationend
        WHEN DATE_DIFF(CAST(datemedicationend AS DATE), CAST(datemedicationstart AS DATE), DAY) >= 5 THEN 
            DATE_DIFF(CAST(datemedicationend AS DATE), CAST(datemedicationstart AS DATE), DAY)
#If there's a next prescription, calculate difference to next start (applies only if the difference is less than 5 days)
        WHEN DATE_DIFF(CAST(datemedicationend AS DATE), CAST(datemedicationstart AS DATE), DAY) < 5 
            AND lead_datemedicationstart IS NOT NULL THEN 
            DATE_DIFF(CAST(lead_datemedicationstart AS DATE), CAST(datemedicationstart AS DATE), DAY)
#Otherwise, calculate difference between start and end of current prescription (applies only if the difference is less than 5 days)
        ELSE 
            DATE_DIFF(CAST(datemedicationend AS DATE), CAST(datemedicationstart AS DATE), DAY)
    END AS duration_in_days,

    name_of_medication,
    medicationdosage,
    medicationquantity

FROM
    PrescriptionDurations
ORDER BY
    person_id,
    datemedicationstart
