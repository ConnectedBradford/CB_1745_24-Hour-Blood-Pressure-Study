#Series of CASE statements - evaluates a series of conditions and returns result for first condition that is true, liaising result as number_of_tablets. If none of the conditions are met, the number_of_tablets will be NULL
#Series of REGEXP_CONTAINS statements checking if 'medicationquantity' matches the regular expression
#The extracted value is CAST into an INT64

(
SELECT 
  *,
  CASE

#Format X tablet, tablet(s), tablets, tab, tabs, capsules, capsule, TABLET, TABLETS, TABLET(S), tablets NOMAD, tablet(s) NOMAD, tabletsNOMAD, tablet(s) Temp., X.00 tablet(s), Tablets
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\b\d+(\.\d+)?\s*tablets?\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)\b(\d+)(?:\.\d+)?\s*tablets?\b') AS INT64)
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\b\d+(\.\d+)?\s*tablet\(s\)\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)\b(\d+)(?:\.\d+)?\s*tablet\(s\)\b') AS INT64)
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\b\d+(\.\d+)?\s*tab\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)\b(\d+)(?:\.\d+)?\s*tab\b') AS INT64)
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\b\d+(\.\d+)?\s*tabs\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)\b(\d+)(?:\.\d+)?\s*tabs\b') AS INT64)
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\b\d+(\.\d+)?\s*capsules?\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)\b(\d+)(?:\.\d+)?\s*capsules?\b') AS INT64)
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\b\d+(\.\d+)?\s*tabl\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)\b(\d+)(?:\.\d+)?\s*tabl\b') AS INT64)
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\b\d+(\.\d+)?\s*TABLET\(S\)\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)\b(\d+)(?:\.\d+)?\s*TABLET\(S\)\b') AS INT64)
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\b\d+(\.\d+)?\s*TABLET\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)\b(\d+)(?:\.\d+)?\s*TABLET\b') AS INT64)

#Format X tablets - n mg, X tablet - n mg, X tablet(s) - n mg
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\b\d+(\.\d+)?\s*tablets?\s*-\s*\d+(\.\d+)?\s*mg\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)\b(\d+)(?:\.\d+)?\s*tablets?\s*-\s*\d+(\.\d+)?\s*mg\b') AS INT64)
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\b\d+(\.\d+)?\s*tablet\(s\)\s*-\s*\d+(\.\d+)?\s*mg\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)\b(\d+)(?:\.\d+)?\s*tablet\(s\)\s*-\s*\d+(\.\d+)?\s*mg\b') AS INT64)
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\b\d+(\.\d+)?\s*tablet\s*-\s*\d+(\.\d+)?\s*mg\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)\b(\d+)(?:\.\d+)?\s*tablet\s*-\s*\d+(\.\d+)?\s*mg\b') AS INT64)

#Format: X
 WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)^\d+$') THEN CAST(medicationquantity AS INT64)

#Format: 'X NOMAD', 'X op', 'Xtablets', 'Xtab', 'Xtablet(s)', 'XNOMAD'
 WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\d+\s*NOMAD\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)(\d+)\s*NOMAD\b') AS INT64)
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\d+\s*op\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)(\d+)\s*op\b') AS INT64)
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\d+tablets\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)(\d+)tablets\b') AS INT64)
    WHEN REGEXP_CONTAINS(medicationquantity, r'(?i)\d+tab\b') THEN CAST(REGEXP_EXTRACT(medicationquantity, r'(?i)(\d+)tab\b') AS INT64)
