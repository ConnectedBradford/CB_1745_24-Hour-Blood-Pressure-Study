#8g - selected rows from raw steroid duration table that do not appear in hand-curated duration table & UNION ALL with hand-curated table

CREATE TABLE `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.final_steroid_length_durations_fixed` AS
SELECT 
*
FROM yhcr-prd-phm-bia-core.CB_MYSPACE_KF.extra_durations_in_days_FINAL_INT

UNION ALL

SELECT
*
FROM (SELECT a.*
FROM yhcr-prd-phm-bia-core.CB_MYSPACE_KF.final_steroid_length_raw a

#Ensures that all rows from the main table a are included, and rows from subquery b are included where there is a match on all columns
LEFT JOIN (
    SELECT *
    FROM yhcr-prd-phm-bia-core.CB_MYSPACE_KF.final_steroid_length_raw
    WHERE duration_in_days > 365
       OR duration_in_days IS NULL
       OR duration_in_days <= 0
) b

#This comparison treats NULL values as equal, ensuring proper handling of NULL values in the join condition
ON a.person_id IS NOT DISTINCT FROM b.person_id
   AND a.diagnosis IS NOT DISTINCT FROM b.diagnosis
   AND a.GCAPMR_date_of_diagnosis IS NOT DISTINCT FROM b.GCAPMR_date_of_diagnosis
   AND a.datemedicationstart IS NOT DISTINCT FROM b.datemedicationstart
   AND a.datemedicationend IS NOT DISTINCT FROM b.datemedicationend
   AND a.duration_in_days IS NOT DISTINCT FROM b.duration_in_days
   AND a.name_of_medication IS NOT DISTINCT FROM b.name_of_medication
   AND a.medicationdosage IS NOT DISTINCT FROM b.medicationdosage
   AND a.medicationquantity IS NOT DISTINCT FROM b.medicationquantity

#Filters out rows from the main table a that have corresponding matches in subquery b
WHERE b.person_id IS NULL)


#8h Dealing with duration_in_days 0-4 and selecting rows with duration_in_days >0 and not NULL from final table (and further removing Rescue packs)
--SAVED AS yhcr-prd-phm-bia-core.CB_MYSPACE_KF.final_steroid_length_durations_fixed_0to4

SELECT * FROM
(WITH all_prescriptions AS (
  SELECT
    person_id,
    diagnosis,
    GCAPMR_date_of_diagnosis,
    datemedicationstart,
    datemedicationend,
    duration_in_days,
    name_of_medication,
    medicationdosage,
    medicationquantity,

#LEAD function finds the next prescription start date for each person
    LEAD(datemedicationstart) OVER (PARTITION BY person_id ORDER BY datemedicationstart) AS next_start
  FROM
    yhcr-prd-phm-bia-core.CB_MYSPACE_KF.final_steroid_length_durations_fixed
)

#Main query starts here
SELECT
  person_id,
  diagnosis,
  GCAPMR_date_of_diagnosis,
  datemedicationstart,
  datemedicationend,

#This CASE statement calculates the new duration_in_days
  CASE

#If duration is 0-4 days and there's a next prescription, calculate new duration
    WHEN duration_in_days IN (0, 1, 2, 3, 4) AND next_start IS NOT NULL
      THEN DATE_DIFF(next_start, datemedicationstart, DAY)

#If duration is 0 and there's no next prescription, set to NULL
    WHEN duration_in_days = 0 AND next_start IS NULL
      THEN NULL

#For all other cases, keep the original duration

    ELSE duration_in_days

  END AS duration_in_days,
  name_of_medication,
  medicationdosage,
  medicationquantity,

  #Keep the original duration for comparison
  duration_in_days AS original_duration_in_days,

#This CASE statement creates a status column to track changes
  CASE
    WHEN duration_in_days IN (0, 1, 2, 3, 4) AND next_start IS NOT NULL THEN 'Changed - Next Prescription'
    WHEN duration_in_days = 0 AND next_start IS NULL THEN 'Changed - Set to NULL'
    ELSE 'Unchanged'
  END AS duration_status

FROM
  all_prescriptions
ORDER BY
  person_id, datemedicationstart)

WHERE 
medicationdosage NOT LIKE '%Rescue%'
AND duration_in_days IS NOT NULL
AND duration_in_days > 0



