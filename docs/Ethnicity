SELECT COUNT (person_id), Ethnic_Group

FROM
#Now make a new variable called ethnic group that is the person table ethnicity when its not missing
#When the person table has missing ethnicity, use the Sr patient table ethnicity- recoded into ethnic groups
#I’ve added 2 examples (I had 84 altogether) but you’ll have to alter this based on the values for your cohort


(SELECT
  person_id,
  ethnicity_concept_id,
  _Ethnic_Group_Person_Table,
  Ethnicity_SR_Table,
  CASE
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Ethnic groups (census) NOS" THEN "Unknown"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table IS NULL THEN "Unknown"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "White British - ethnic category 2001 census" THEN "White"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "White:Eng/Welsh/Scot/NI/Brit - England and Wales 2011 census" THEN "White"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "White British" THEN "White"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Indian or British Indian - ethnic category 2001 census" THEN "Indian/British Indian"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "British or mixed British - ethnic category 2001 census" THEN "White"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Polish - ethnic category 2001 census" THEN "White"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Other ethnic Asian/White orig" THEN "Other Asian"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Other White background - ethnic category 2001 census" THEN "White"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Bangladeshi" THEN "Bangladeshi"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "White Irish" THEN "White"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "White - ethnic group" THEN "White"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "English - ethnic category 2001 census" THEN "White"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Pakistani or British Pakistani - ethnic category 2001 census" THEN "Pakistani"
    WHEN _Ethnic_Group_Person_Table = "Other ethnic group: any other ethnic group - England and Wales ethnic category 2011 census" AND Ethnicity_SR_Table = "Other ethnic group" THEN "Unknown"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Irish - ethnic category 2001 census" THEN "White"
    WHEN _Ethnic_Group_Person_Table = "Other ethnic group: any other ethnic group - England and Wales ethnic category 2011 census" AND Ethnicity_SR_Table = "Latin American - ethnic category 2001 census" THEN "Latin American"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Asian - ethnic group" THEN "Other Asian"
    WHEN _Ethnic_Group_Person_Table = "Other ethnic group: any other ethnic group - England and Wales ethnic category 2011 census" AND Ethnicity_SR_Table = "O/E - ethnic group" THEN "Unknown"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Pakistani" THEN "Pakistani"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Other ethnic group" THEN "Unknown"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Asian/Asian British:Pakistani- Eng+Wales eth cat 2011 census" THEN "Pakistani"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "White Irish - ethnic category 2001 census" THEN "White"
    WHEN _Ethnic_Group_Person_Table = "Other ethnic group: any other ethnic group - England and Wales ethnic category 2011 census" AND Ethnicity_SR_Table = "Other ethnic: any other grp - Eng+Wales eth cat 2011 census" THEN "Unknown"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Asian/Asian Brit: other Asian- Eng+Wales eth cat 2011 census" THEN "Other Asian"
    WHEN _Ethnic_Group_Person_Table = "Other ethnic group: any other ethnic group - England and Wales ethnic category 2011 census" AND Ethnicity_SR_Table IS NULL THEN "Unknown"
    WHEN _Ethnic_Group_Person_Table = "Unknown" AND Ethnicity_SR_Table = "Other Asian background - ethnic category 2001 census" THEN "Other Asian"
    ELSE _Ethnic_Group_Person_Table
  END AS Ethnic_Group
FROM yhcr-prd-phm-bia-core.CB_MYSPACE_KF.working_table_12_07)

GROUP BY Ethnic_Group
