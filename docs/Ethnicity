#Query ethnicity count from person table

SELECT COUNT (person_id), ethnicity
FROM
(SELECT
  a.person_id,
  a.ethnicity_source_value as ethnicity
FROM
  yhcr-prd-phm-bia-core.CB_FDM_PrimaryCare.person a,
  yhcr-prd-phm-bia-core.CB_1745.Final_cohort_with_steroids b

WHERE a.person_id = b.person_id)



