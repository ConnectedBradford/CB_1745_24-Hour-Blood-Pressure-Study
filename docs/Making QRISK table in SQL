#SD Systolic BP


WITH calculated_bp AS (
  SELECT 
    b.person_id,
    CASE
      WHEN l.gender = 1 THEN  -- Women
        CASE
          WHEN b.Age_GCAPMR_Diagnosis BETWEEN 50 AND 59 THEN 12.05528795461959
          WHEN b.Age_GCAPMR_Diagnosis BETWEEN 60 AND 69 THEN 13.373754911122802
          WHEN b.Age_GCAPMR_Diagnosis BETWEEN 70 AND 79 THEN 14.68669516021431
          WHEN b.Age_GCAPMR_Diagnosis BETWEEN 80 AND 84 THEN 15.319987224734321
          ELSE NULL
        END
      WHEN l.gender = 0 THEN  -- Men
        CASE
          WHEN b.Age_GCAPMR_Diagnosis BETWEEN 50 AND 59 THEN 12.200638493036678
          WHEN b.Age_GCAPMR_Diagnosis BETWEEN 60 AND 69 THEN 13.051617804679077
          WHEN b.Age_GCAPMR_Diagnosis BETWEEN 70 AND 79 THEN 13.808560926229649
          WHEN b.Age_GCAPMR_Diagnosis BETWEEN 80 AND 84 THEN 14.32510587572084
         ELSE NULL
        END
      ELSE NULL
    END AS st_dev_systolic
  FROM
    `yhcr-prd-phm-bia-core.CB_1745.PMR_GCA_Cohort` b
  JOIN
    `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.gender_QRISK` l ON b.person_id = l.person_id
  WHERE
    b.person_id NOT IN (
      SELECT person_id 
      FROM `yhcr-prd-phm-bia-core.CB_1745.For_Kat_GCAPMR_BPSTDEV`
    )
)

SELECT person_id, st_dev_systolic
FROM calculated_bp

UNION ALL 

SELECT person_id, st_dev_systolic
FROM `yhcr-prd-phm-bia-core.CB_1745.For_Kat_GCAPMR_BPSTDEV`





