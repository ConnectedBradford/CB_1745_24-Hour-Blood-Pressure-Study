    term
  FROM
    `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.T1DM_codes`
),

DeduplicatedSnomed AS (
  -- Fourth query - deduplicate, only selecting one unique snomed code
  SELECT
    code,
    ANY_VALUE(term) AS term
  FROM
    CTV3ToSnomed
  GROUP BY
    code
