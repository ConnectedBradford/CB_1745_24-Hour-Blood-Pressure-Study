(WITH CTV3ToSnomed AS (
  -- First query - converts ctv3 codes to snomed codes
  SELECT
    CAST(a.SCT_CONCEPTID AS STRING) AS code,
    b.string_field_1 AS term
  FROM
    `yhcr-prd-phm-bia-core.CB_LOOKUPS.tbl_CTV3ToSnomed_Map_2` a
  JOIN
    `yhcr-prd-phm-bia-core.CB_MYSPACE_KF.T1DM_ctv3` b
